<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/surface_background</item>
        <item name="android:colorBackground">@color/surface_background</item>
        <item name="android:textColorPrimary">@color/surface_text</item>

        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:colorControlActivated">@color/brand_primary</item>
        <item name="android:statusBarColor">@color/surface_background</item>
        <item name="android:navigationBarColor">@color/surface_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item></style>

    <style name="ImeTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/surface_background</item>
        <item name="android:colorBackground">@color/surface_background</item>
        <item name="android:textColorPrimary">@color/surface_text</item>
        <item name="android:navigationBarColor">@color/surface_background</item>

        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:colorControlActivated">@color/brand_primary</item>
        <item name="android:statusBarColor">@color/surface_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item></style>
</resources>
